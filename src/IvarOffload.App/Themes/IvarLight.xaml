<!-- IVAR Studios design system (v1, 3 November 2026), Light theme. The seven neutral roles and the accents, laid over the
     Fluent theme's own keys so every control follows them. App.ApplyIvarTheme loads this file or its twin. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Neutral roles: bg, surface, surface-2, line, text-3, text-2, text -->
    <SolidColorBrush x:Key="ApplicationBackgroundBrush" Color="#FAFAFA" />
    <SolidColorBrush x:Key="SolidBackgroundFillColorBaseBrush" Color="#FAFAFA" />
    <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="#F2F2F2" />
    <SolidColorBrush x:Key="CardBackgroundFillColorSecondaryBrush" Color="#F2F2F2" />
    <SolidColorBrush x:Key="LayerFillColorDefaultBrush" Color="#F2F2F2" />
    <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="#E0E0E0" />
    <SolidColorBrush x:Key="CardStrokeColorDefaultSolidBrush" Color="#E0E0E0" />
    <SolidColorBrush x:Key="DividerStrokeColorDefaultBrush" Color="#E0E0E0" />
    <SolidColorBrush x:Key="SurfaceStrokeColorDefaultBrush" Color="#E0E0E0" />
    <SolidColorBrush x:Key="SurfaceStrokeColorFlyoutBrush" Color="#E0E0E0" />
    <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#1A1A1A" />
    <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#6B6B6B" />
    <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="#8A8A8A" />

    <!-- Controls: fields and plain buttons sit on the surface roles -->
    <SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="#FAFAFA" />
    <SolidColorBrush x:Key="ControlFillColorSecondaryBrush" Color="#EDEDED" />
    <SolidColorBrush x:Key="ControlFillColorTertiaryBrush" Color="#E8E8E8" />
    <SolidColorBrush x:Key="ControlFillColorInputActiveBrush" Color="#FAFAFA" />
    <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush" Color="#E0E0E0" />
    <SolidColorBrush x:Key="ControlStrokeColorSecondaryBrush" Color="#E0E0E0" />
    <SolidColorBrush x:Key="ControlElevationBorderBrush" Color="#E0E0E0" />
    <SolidColorBrush x:Key="TextControlElevationBorderBrush" Color="#E0E0E0" />
    <SolidColorBrush x:Key="SubtleFillColorSecondaryBrush" Color="#E8E8E8" />
    <SolidColorBrush x:Key="SubtleFillColorTertiaryBrush" Color="#E0E0E0" />
    <SolidColorBrush x:Key="SolidBackgroundFillColorQuarternaryBrush" Color="#FAFAFA" />

    <!-- Accent: Glacier teal for what you can click and for labels. Text in teal uses accent bright on dark. -->
    <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#267B8C" />
    <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#267B8C" Opacity="0.9" />
    <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#267B8C" Opacity="0.8" />
    <SolidColorBrush x:Key="AccentControlElevationBorderBrush" Color="#267B8C" />
    <SolidColorBrush x:Key="AccentButtonBorderBrush" Color="#267B8C" />
    <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="TextOnAccentFillColorSecondaryBrush" Color="#FFFFFF" Opacity="0.85" />
    <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#267B8C" />
    <SolidColorBrush x:Key="AccentTextFillColorSecondaryBrush" Color="#267B8C" Opacity="0.9" />
    <SolidColorBrush x:Key="AccentTextFillColorTertiaryBrush" Color="#267B8C" Opacity="0.8" />
    <SolidColorBrush x:Key="TextControlElevationBorderFocusedBrush" Color="#267B8C" />
    <SolidColorBrush x:Key="TextControlFocusedBorderBrush" Color="#267B8C" />
    <SolidColorBrush x:Key="AccentFillColorSelectedTextBackgroundBrush" Color="#267B8C" />
    <SolidColorBrush x:Key="DataGridRowSelectedBackgroundThemeBrush" Color="#1A267B8C" />
    <SolidColorBrush x:Key="ListBoxItemSelectedBackgroundThemeBrush" Color="#1A267B8C" />
    <SolidColorBrush x:Key="ListViewItemPillFillBrush" Color="#267B8C" />

    <!-- Controls that the Fluent theme colours with the Windows accent: checked boxes, radio buttons, switches,
         progress bars, selection marks and links -->
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillChecked" Color="#267B8C" />
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPointerOver" Color="#267B8C" />
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPressed" Color="#267B8C" />
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillIndeterminate" Color="#267B8C" />
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillIndeterminatePointerOver" Color="#267B8C" />
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillIndeterminatePressed" Color="#267B8C" />
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeChecked" Color="#267B8C" />
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeCheckedPointerOver" Color="#267B8C" />
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeCheckedPressed" Color="#267B8C" />
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeIndeterminate" Color="#267B8C" />
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeIndeterminatePointerOver" Color="#267B8C" />
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeIndeterminatePressed" Color="#267B8C" />
    <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedFill" Color="#267B8C" />
    <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedStroke" Color="#267B8C" />
    <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedStrokePointerOver" Color="#267B8C" />
    <SolidColorBrush x:Key="RadioButtonCheckOuterEllipseCheckedFillPointerOver" Color="#267B8C" />
    <SolidColorBrush x:Key="RadioButtonCheckOuterEllipseCheckedFillPressed" Color="#267B8C" />
    <SolidColorBrush x:Key="RadioButtonCheckOuterEllipseCheckedStrokePressed" Color="#267B8C" />
    <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="#267B8C" />
    <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver" Color="#267B8C" />
    <SolidColorBrush x:Key="ProgressBarForeground" Color="#267B8C" />
    <SolidColorBrush x:Key="ProgressBarIndicatorAnimatedFill" Color="#267B8C" />
    <SolidColorBrush x:Key="SliderThumbBackground" Color="#267B8C" />
    <SolidColorBrush x:Key="SliderTrackFill" Color="#267B8C" />
    <SolidColorBrush x:Key="ComboBoxItemPillFillBrush" Color="#267B8C" />
    <SolidColorBrush x:Key="SelectionIndicatorForeground" Color="#267B8C" />
    <SolidColorBrush x:Key="CheckBoxCheckGlyphForeground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="HyperlinkForeground" Color="#267B8C" />
    <SolidColorBrush x:Key="HyperlinkForegroundPointerOver" Color="#267B8C" />
    <SolidColorBrush x:Key="HyperlinkButtonForeground" Color="#267B8C" />
    <SolidColorBrush x:Key="HyperlinkButtonForegroundPointerOver" Color="#267B8C" />

    <!-- A chosen option (soft pill): a teal tint with teal text -->
    <SolidColorBrush x:Key="IvarSoftFillBrush" Color="#1A267B8C" />

    <!-- The one main action on a screen: orange with an ink label -->
    <SolidColorBrush x:Key="IvarActionBrush" Color="#E8892B" />
    <SolidColorBrush x:Key="IvarOnActionBrush" Color="#1A1A1A" />
</ResourceDictionary>
