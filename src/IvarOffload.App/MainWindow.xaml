<Window x:Class="IvarOffload.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:IvarOffload.App"
        xmlns:jobs="clr-namespace:IvarOffload.Core.Jobs;assembly=IvarOffload.Core"
        Title="IVAR Offload" Icon="app.ico" Width="1280" Height="940" MinWidth="1000" MinHeight="540"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource ApplicationBackgroundBrush}" Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <Window.DataContext>
        <local:MainViewModel />
    </Window.DataContext>
    <Window.TaskbarItemInfo>
        <TaskbarItemInfo ProgressValue="{Binding Progress}" ProgressState="{Binding TaskbarState}" />
    </Window.TaskbarItemInfo>
    <Window.Resources>
        <DataTemplate x:Key="MessageTemplate" DataType="{x:Type local:MessageRow}">
            <DockPanel Margin="0,0,0,6">
                <TextBlock x:Name="icon" Style="{StaticResource Icon}" Text="{Binding Icon}" VerticalAlignment="Top" Margin="0,2,10,0"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <TextBlock Text="{Binding Text}" TextWrapping="Wrap" />
            </DockPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Level}" Value="Warning">
                    <Setter TargetName="icon" Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Level}" Value="Error">
                    <Setter TargetName="icon" Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="48,28,48,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Name, logo and version: small, in the lower right corner -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0" Opacity="0.6">
            <Rectangle Width="15" Height="17" Margin="0,0,7,0" VerticalAlignment="Center"
                       Fill="{DynamicResource TextFillColorPrimaryBrush}" OpacityMask="{StaticResource LogoMask}"
                       AutomationProperties.AutomationId="HeaderLogo" AutomationProperties.Name="IVAR Offload logo" />
            <TextBlock Text="IVAR Offload" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" />
            <TextBlock Text="{Binding VersionText}" AutomationProperties.AutomationId="VersionText" Style="{StaticResource Caption}"
                       FontSize="12" VerticalAlignment="Center" Margin="8,0,0,0" />
        </StackPanel>

        <Grid>
            <TabControl SelectedIndex="{Binding SelectedModeTab}" AutomationProperties.AutomationId="ModeTabs" Style="{StaticResource ModeTabs}">

                <!-- =============================================== BACKUP =============================================== -->
                <TabItem Tag="{StaticResource BackupAccent}" AutomationProperties.AutomationId="BackupTab" AutomationProperties.Name="Backup">
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE8C8;" Margin="0,0,10,0" />
                            <TextBlock Text="Backup" />
                        </StackPanel>
                    </TabItem.Header>
                    <local:BackupView DataContext="{Binding Backup}" />
                </TabItem>

                <!-- ================================================ SORT ================================================ -->
                <TabItem Tag="{StaticResource SortAccent}" AutomationProperties.AutomationId="SortTab" AutomationProperties.Name="Sort">
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE8CB;" Margin="0,0,10,0" />
                            <TextBlock Text="Sort" />
                        </StackPanel>
                    </TabItem.Header>
                    <DockPanel Margin="0,36,0,0">
                        <DockPanel.Resources>
                            <!-- The Sort colour for everything accented on this tab: buttons, progress bars, check boxes. -->
                            <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#4F46E5" />
                            <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#4F46E5" Opacity="0.9" />
                            <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#4F46E5" Opacity="0.8" />
                            <SolidColorBrush x:Key="ModeAccentBrush" Color="#4F46E5" />
                        </DockPanel.Resources>

                        <!-- Action bar: always visible -->
                        <Border DockPanel.Dock="Bottom" Margin="0,16,0,0" Padding="0,18,0,0" BorderThickness="0,1,0,0"
                                BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.ColumnSpan="2" HorizontalAlignment="Right" Margin="0,0,0,8"
                                            Visibility="{Binding ShowConfirm, Converter={StaticResource VisibleWhen}}">
                                    <!-- A memory card or camera drive: said here, next to Confirm, where no scrolling can hide it -->
                                    <DockPanel HorizontalAlignment="Right" Margin="0,0,0,4" Visibility="{Binding HasCardLine, Converter={StaticResource VisibleWhen}}">
                                        <TextBlock DockPanel.Dock="Left" Style="{StaticResource Icon}" Text="&#xE7BA;" Margin="0,0,8,0" VerticalAlignment="Top"
                                                   Foreground="{DynamicResource SystemFillColorCautionBrush}" />
                                        <TextBlock Text="{Binding CardLine}" AutomationProperties.AutomationId="CardLine" FontWeight="SemiBold"
                                                   TextWrapping="Wrap" TextAlignment="Right" Foreground="{DynamicResource SystemFillColorCautionBrush}" />
                                    </DockPanel>
                                    <DockPanel HorizontalAlignment="Right">
                                        <TextBlock DockPanel.Dock="Left" Style="{StaticResource Icon}" Text="&#xE7BA;" Margin="0,0,8,0"
                                                   Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                                   Visibility="{Binding DestinationWarn, Converter={StaticResource VisibleWhen}}" />
                                        <TextBlock Text="{Binding DestinationLine}" AutomationProperties.AutomationId="DestinationLine" FontWeight="Bold"
                                                   TextWrapping="Wrap" TextAlignment="Right">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding DestinationWarn}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                                            <Setter Property="ToolTip" Value="{Binding DestinationWarnText}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DockPanel>
                                </StackPanel>

                                <StackPanel Grid.Row="1" VerticalAlignment="Center">
                                    <StackPanel Visibility="{Binding IsRunning, Converter={StaticResource VisibleWhen}}">
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding ProgressRight}" Style="{StaticResource Caption}" Margin="12,0,0,0" />
                                            <TextBlock Text="{Binding ProgressLeft}" />
                                        </DockPanel>
                                        <ProgressBar Value="{Binding Progress, Mode=OneWay}" Maximum="1" Height="6" Margin="0,8,0,6" Foreground="{StaticResource SortAccent}" />
                                        <TextBlock Text="{Binding ProgressFile}" Style="{StaticResource Caption}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <DockPanel Visibility="{Binding IsRunning, Converter={StaticResource VisibleWhen}, ConverterParameter=invert}">
                                        <ProgressBar DockPanel.Dock="Left" IsIndeterminate="True" Width="80" Height="4" Margin="0,0,12,0"
                                                     Visibility="{Binding IsBusy, Converter={StaticResource VisibleWhen}}" />
                                        <TextBlock Text="{Binding Status}" AutomationProperties.AutomationId="StatusText" TextWrapping="Wrap" VerticalAlignment="Center" />
                                    </DockPanel>
                                    <TextBlock Text="{Binding Status}" Style="{StaticResource Caption}" Margin="0,4,0,0" TextWrapping="Wrap"
                                               Visibility="{Binding IsPaused, Converter={StaticResource VisibleWhen}}" />
                                </StackPanel>

                                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                                    <Button Content="{Binding PauseText}" AutomationProperties.AutomationId="PauseButton" Command="{Binding PauseCommand}" MinWidth="100" Height="34" Margin="0,0,8,0"
                                            Visibility="{Binding ShowPause, Converter={StaticResource VisibleWhen}}"
                                            ToolTip="Pauses between steps. Do not unplug the drives while paused - press Stop first." />
                                    <Button Content="Stop" Command="{Binding StopCommand}" AutomationProperties.AutomationId="StopButton" MinWidth="100" Height="34"
                                            Visibility="{Binding ShowStop, Converter={StaticResource VisibleWhen}}"
                                            ToolTip="Stops safely: the file in progress is finished or rolled back. Then it is safe to unplug the drives, and the job can be resumed." />
                                    <Button Command="{Binding ConfirmCommand}" AutomationProperties.AutomationId="ConfirmButton" AutomationProperties.Name="Confirm move"
                                            Style="{StaticResource ModeButton}" MinWidth="230" Height="38"
                                            Visibility="{Binding ShowConfirm, Converter={StaticResource VisibleWhen}}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource Icon}" Text="&#xE8DE;" Margin="0,0,8,0" />
                                            <TextBlock Text="{Binding ConfirmText}" FontWeight="SemiBold" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Grid x:Name="SortArea">
                            <Grid.RowDefinitions>
                                <!-- While the lists are hidden, the upper part takes the whole height (the setup is centred in it) and theirs none -->
                                <RowDefinition>
                                    <RowDefinition.Style>
                                        <Style TargetType="RowDefinition">
                                            <Setter Property="Height" Value="Auto" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ShowLists}" Value="False">
                                                    <Setter Property="Height" Value="*" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </RowDefinition.Style>
                                </RowDefinition>
                                <RowDefinition>
                                    <RowDefinition.Style>
                                        <Style TargetType="RowDefinition">
                                            <Setter Property="Height" Value="*" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ShowLists}" Value="False">
                                                    <Setter Property="Height" Value="Auto" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </RowDefinition.Style>
                                </RowDefinition>
                            </Grid.RowDefinitions>

                            <!-- Upper part: scrolls when the window is short, so the lists and the action bar keep their room -->
                            <Grid>
                                <ScrollViewer x:Name="UpperScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                              AutomationProperties.AutomationId="UpperArea">
                                    <ScrollViewer.MaxHeight>
                                        <MultiBinding Converter="{StaticResource UpperAreaHeight}">
                                            <Binding ElementName="SortArea" Path="ActualHeight" />
                                            <Binding Path="ShowLists" />
                                            <Binding Path="ListsMinHeight" />
                                            <Binding Path="ListsGrow" />
                                        </MultiBinding>
                                    </ScrollViewer.MaxHeight>
                                    <!-- Before a scan the setup is the whole page: centred in the height, so the space above and below it grows with the window -->
                                    <Grid MinHeight="{Binding ViewportHeight, ElementName=UpperScroll}">
                                    <StackPanel Style="{StaticResource CentredWhileSetup}">

                                        <!-- Result -->
                                        <Border Style="{StaticResource Card}" Margin="0,0,0,20" Visibility="{Binding HasResult, Converter={StaticResource VisibleWhen}}"
                                                AutomationProperties.AutomationId="ResultCard">
                                            <DockPanel>
                                                <Grid DockPanel.Dock="Left" Margin="0,2,14,0" VerticalAlignment="Top" Width="24">
                                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE73E;" FontSize="22" Foreground="{DynamicResource SystemFillColorSuccessBrush}"
                                                               AutomationProperties.AutomationId="ResultGoodIcon" AutomationProperties.Name="Done, nothing left behind"
                                                               Visibility="{Binding ResultIsGood, Converter={StaticResource VisibleWhen}}" />
                                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE7BA;" FontSize="22" Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                                               AutomationProperties.AutomationId="ResultWarningIcon" AutomationProperties.Name="Needs attention"
                                                               Visibility="{Binding ResultIsAttention, Converter={StaticResource VisibleWhen}}" />
                                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE895;" FontSize="20" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                               AutomationProperties.AutomationId="ResultCheckingIcon" AutomationProperties.Name="Checking"
                                                               Visibility="{Binding ResultIsChecking, Converter={StaticResource VisibleWhen}}" />
                                                </Grid>
                                                <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                                                    <!-- The common next steps; the rest behind "More" -->
                                                    <WrapPanel>
                                                        <WrapPanel.Resources>
                                                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                                <Setter Property="Margin" Value="0,4,8,0" />
                                                            </Style>
                                                        </WrapPanel.Resources>
                                                        <Button Content="{Binding OpenTargetText}" Command="{Binding OpenTargetCommand}" AutomationProperties.AutomationId="OpenTargetButton" MinWidth="140" />
                                                        <Button Content="Undo this sort" Command="{Binding UndoLastCommand}" AutomationProperties.AutomationId="UndoButton" MinWidth="130"
                                                                Visibility="{Binding CanUndoLastJob, Converter={StaticResource VisibleWhen}}"
                                                                ToolTip="Moves the files of this sort back where they came from. You see what will happen before anything moves." />
                                                        <Button Content="{Binding ShowStillInSourceText}" Command="{Binding ShowStillInSourceCommand}" AutomationProperties.AutomationId="ShowStillInSourceButton" MinWidth="200"
                                                                Visibility="{Binding HasStillInSource, Converter={StaticResource VisibleWhen}}" />
                                                        <ToggleButton IsChecked="{Binding ShowMore}" Margin="0,4,8,0" Padding="12,5" AutomationProperties.AutomationId="MoreButton"
                                                                      AutomationProperties.Name="More actions">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="More" />
                                                                <TextBlock Style="{StaticResource Icon}" Text="&#xE70D;" FontSize="10" Margin="6,1,0,0" VerticalAlignment="Center" />
                                                            </StackPanel>
                                                        </ToggleButton>
                                                    </WrapPanel>
                                                    <WrapPanel Margin="0,4,0,0" Visibility="{Binding ShowMore, Converter={StaticResource VisibleWhen}}">
                                                        <WrapPanel.Resources>
                                                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                                <Setter Property="Margin" Value="0,4,8,0" />
                                                            </Style>
                                                        </WrapPanel.Resources>
                                                        <Button Content="Check the moved files again" AutomationProperties.AutomationId="VerifyButton" Command="{Binding VerifyCommand}" MinWidth="170"
                                                                ToolTip="Reads every moved file again and compares it with how it was when it moved" />
                                                        <Button Content="Open report" Command="{Binding OpenLogCommand}" AutomationProperties.AutomationId="OpenLogButton" MinWidth="110"
                                                                ToolTip="The list of every file, where it went, and how it was checked" />
                                                        <Button Content="{Binding RemoveEmptyText}" AutomationProperties.AutomationId="RemoveEmptyButton" Command="{Binding RemoveEmptyFoldersCommand}" MinWidth="200"
                                                                Visibility="{Binding EmptyFolderCount, Converter={StaticResource VisibleWhen}}"
                                                                ToolTip="Folders that only held moved files and are now completely empty. You are asked first." />
                                                    </WrapPanel>
                                                </StackPanel>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding ResultTitle}" AutomationProperties.AutomationId="ResultTitle" FontWeight="SemiBold" FontSize="16" TextWrapping="Wrap" />
                                                    <TextBlock Text="{Binding ResultAlarm}" AutomationProperties.AutomationId="ResultAlarm" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,6,0,0"
                                                               Foreground="{DynamicResource SystemFillColorCriticalBrush}" Visibility="{Binding ResultAlarm, Converter={StaticResource VisibleWhen}}" />
                                                    <TextBlock Text="{Binding ResultLeftLine}" AutomationProperties.AutomationId="ResultLeftLine" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,6,0,0"
                                                               Visibility="{Binding ResultLeftLine, Converter={StaticResource VisibleWhen}}" />
                                                    <ItemsControl ItemsSource="{Binding ResultReasons}" AutomationProperties.AutomationId="ResultReasons" Margin="0,4,0,0"
                                                                  Visibility="{Binding HasResultReasons, Converter={StaticResource VisibleWhen}}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <DockPanel Margin="0,1,0,0">
                                                                    <TextBlock DockPanel.Dock="Left" Text="•" Style="{StaticResource Caption}" Margin="4,0,8,0" />
                                                                    <TextBlock Text="{Binding}" Style="{StaticResource Caption}" />
                                                                </DockPanel>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                    <TextBlock Text="{Binding ResultDetail}" AutomationProperties.AutomationId="ResultDetail" Style="{StaticResource Caption}" Margin="0,6,0,0"
                                                               Visibility="{Binding ResultDetail, Converter={StaticResource VisibleWhen}}" />
                                                    <Expander Header="Details" Margin="0,8,0,0" AutomationProperties.AutomationId="ResultTechnical"
                                                              Visibility="{Binding HasResultTechnical, Converter={StaticResource VisibleWhen}}">
                                                        <ItemsControl ItemsSource="{Binding ResultTechnical}" Margin="0,4,0,0">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <TextBlock Text="{Binding}" Style="{StaticResource Caption}" Margin="0,1,0,0" />
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </Expander>
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>

                                        <!-- Unfinished job -->
                                        <Border Margin="0,0,0,20" Padding="20,16" CornerRadius="8" BorderThickness="1"
                                                Background="{DynamicResource SystemFillColorCautionBackgroundBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                                Visibility="{Binding HasBanner, Converter={StaticResource VisibleWhen}}" AutomationProperties.AutomationId="UnfinishedBanner">
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Left" Style="{StaticResource Icon}" Text="&#xE7BA;" FontSize="20" VerticalAlignment="Top" Margin="0,2,14,0"
                                                           Foreground="{DynamicResource SystemFillColorCautionBrush}" />
                                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                                                    <Button Content="Resume" Command="{Binding ResumeJobCommand}" AutomationProperties.AutomationId="ResumeButton" Style="{StaticResource ModeButton}" MinWidth="110" Margin="0,0,8,0" />
                                                    <Button Content="{Binding CloseJobText}" Command="{Binding CloseJobCommand}" AutomationProperties.AutomationId="CloseJobButton" MinWidth="110"
                                                            ToolTip="{Binding CloseJobToolTip}" />
                                                </StackPanel>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding BannerTitle}" AutomationProperties.AutomationId="BannerTitle" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                    <TextBlock Text="{Binding BannerPaths}" Margin="0,2,0,0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                                               ToolTip="{Binding BannerPaths}" Visibility="{Binding ShowBannerPaths, Converter={StaticResource VisibleWhen}}" />
                                                    <TextBlock Text="{Binding BannerText}" Style="{StaticResource Caption}" Margin="0,2,0,0" />
                                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0" Visibility="{Binding BannerOffline, Converter={StaticResource VisibleWhen}}">
                                                        <Button Content="Check again" Style="{StaticResource LinkButton}" Command="{Binding RecheckJobsCommand}" AutomationProperties.AutomationId="RecheckJobsButton" Margin="0,0,18,0" />
                                                        <Button Content="Forget this job" Style="{StaticResource LinkButton}" Command="{Binding ForgetJobCommand}" AutomationProperties.AutomationId="ForgetJobButton" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>

                                        <!-- Setup: the source on the left, the target on the right - the way the files travel -->
                                        <Grid Margin="0,0,0,24" Visibility="{Binding IsSetupFull, Converter={StaticResource VisibleWhen}}"
                                              AutomationProperties.AutomationId="SetupCard">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="{StaticResource TravelColumn}" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <!-- From -->
                                            <Border Style="{StaticResource SidePanel}">
                                                <StackPanel>
                                                    <TextBlock Text="FROM" Style="{StaticResource SideLabel}" />
                                                    <DockPanel Margin="0,0,0,14">
                                                        <local:InfoTip DockPanel.Dock="Right" AutomationProperties.Name="About the folder to sort"
                                                                       Content="The folder with your card backup, e.g. E:\Backups\Card1. Nothing in it moves until you confirm." />
                                                        <TextBlock Text="Folder to sort" Style="{StaticResource FieldTitle}" />
                                                    </DockPanel>
                                                    <DockPanel>
                                                        <Button DockPanel.Dock="Right" Content="Browse..." Command="{Binding BrowseSourceCommand}" AutomationProperties.AutomationId="BrowseSource" MinWidth="100" />
                                                        <TextBox Margin="0,0,8,0" AutomationProperties.AutomationId="SourceBox" AutomationProperties.Name="Folder to sort" VerticalContentAlignment="Center"
                                                                 Text="{Binding SourcePath, UpdateSourceTrigger=PropertyChanged, Delay=500}" IsEnabled="{Binding CanEditInputs}" />
                                                    </DockPanel>
                                                </StackPanel>
                                            </Border>

                                            <!-- The arrow, and what travels along it -->
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                                                <TextBlock Style="{StaticResource TravelArrow}" Margin="0,0,0,12" />
                                                <TextBlock Text="What to move" Style="{StaticResource Caption}" HorizontalAlignment="Center" Margin="0,0,0,6" />
                                                <RadioButton Style="{StaticResource ChoicePill}" GroupName="Mode" IsChecked="{Binding MoveVideos}" IsEnabled="{Binding CanEditInputs}" Width="160" Margin="0,0,0,8"
                                                             AutomationProperties.AutomationId="ModeVideos" AutomationProperties.Name="Videos" Content="Videos" />
                                                <RadioButton Style="{StaticResource ChoicePill}" GroupName="Mode" IsChecked="{Binding MovePhotos}" IsEnabled="{Binding CanEditInputs}" Width="160"
                                                             AutomationProperties.AutomationId="ModePhotos" AutomationProperties.Name="Photos" Content="Photos" />
                                                <local:InfoTip HorizontalAlignment="Center" Margin="0,8,0,0" AutomationProperties.Name="What moves" Content="{Binding ModeHint}" />
                                            </StackPanel>

                                            <!-- To -->
                                            <Border Grid.Column="2" Style="{StaticResource SidePanel}">
                                                <StackPanel>
                                                    <TextBlock Text="TO" Style="{StaticResource SideLabel}" />
                                                    <DockPanel Margin="0,0,0,14">
                                                        <local:InfoTip DockPanel.Dock="Right" AutomationProperties.Name="About where they go"
                                                                       Content="Where the videos (or photos) go. Their sub-folders are kept, so every file is easy to find. It can be a new folder, also one inside the folder to sort." />
                                                        <TextBlock Text="Move them to" Style="{StaticResource FieldTitle}" />
                                                    </DockPanel>
                                                    <DockPanel>
                                                        <Button DockPanel.Dock="Right" Content="Browse..." Command="{Binding BrowseTargetCommand}" AutomationProperties.AutomationId="BrowseTarget" MinWidth="100" />
                                                        <TextBox Margin="0,0,8,0" AutomationProperties.AutomationId="TargetBox" AutomationProperties.Name="Move them to" VerticalContentAlignment="Center"
                                                                 Text="{Binding TargetPath, UpdateSourceTrigger=PropertyChanged, Delay=500}" IsEnabled="{Binding CanEditInputs}" />
                                                    </DockPanel>
                                                </StackPanel>
                                            </Border>

                                            <DockPanel Grid.Row="1" Grid.ColumnSpan="3" Margin="0,24,0,0">
                                                <Button DockPanel.Dock="Right" Command="{Binding ScanCommand}" AutomationProperties.AutomationId="ScanButton" AutomationProperties.Name="Check folder" Style="{StaticResource ModeButton}" MinWidth="190" Height="38"
                                                        ToolTip="Reads the folder and shows what will move and what stays. Nothing moves yet.">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE721;" Margin="0,0,8,0" />
                                                        <TextBlock Text="Check folder" />
                                                    </StackPanel>
                                                </Button>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <CheckBox Content="Record checksums" IsChecked="{Binding VerifyChecksums}" IsEnabled="{Binding CanEditInputs}" VerticalAlignment="Center"
                                                              AutomationProperties.AutomationId="ChecksumBox" AutomationProperties.Name="Record checksums" />
                                                    <local:InfoTip Margin="2,0,0,0" AutomationProperties.Name="About checksums"
                                                                   Content="Records a fingerprint of every file in the report, so you can later prove nothing changed (recommended). When files move between drives this is always done." />
                                                </StackPanel>
                                            </DockPanel>
                                        </Grid>

                                        <!-- Setup, after a scan: one line, still from left to right -->
                                        <Border Style="{StaticResource Card}" Padding="20,12" Margin="0,0,0,20" Visibility="{Binding IsSetupCompact, Converter={StaticResource VisibleWhen}}"
                                                AutomationProperties.AutomationId="SetupSummary">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="{StaticResource TravelColumn}" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding SourcePath}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                                                           ToolTip="{Binding SourcePath}" />
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding ModeWord}" FontWeight="Bold" FontSize="12" VerticalAlignment="Center" Margin="0,0,10,0" />
                                                    <TextBlock Style="{StaticResource TravelArrow}" FontSize="18" />
                                                </StackPanel>
                                                <DockPanel Grid.Column="2">
                                                    <Button DockPanel.Dock="Right" Content="{Binding ChangeSetupText}" Command="{Binding ChangeSetupCommand}" AutomationProperties.AutomationId="ChangeSetupButton" MinWidth="90" Margin="16,0,0,0"
                                                            ToolTip="Change the folder, where they go, or what moves" />
                                                    <TextBlock Text="{Binding TargetPath}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                                                               ToolTip="{Binding TargetPath}" />
                                                </DockPanel>
                                            </Grid>
                                        </Border>

                                        <!-- Preview summary: what will happen, at a glance (on a laptop it stays in view) -->
                                        <UniformGrid Columns="4" Margin="-8,0,-8,20" Visibility="{Binding ShowPlanSummary, Converter={StaticResource VisibleWhen}}">
                                            <UniformGrid.Resources>
                                                <Style TargetType="Border" BasedOn="{StaticResource Card}">
                                                    <Setter Property="Padding" Value="18,14" />
                                                    <Setter Property="Margin" Value="8,0" />
                                                </Style>
                                            </UniformGrid.Resources>
                                            <Border>
                                                <StackPanel>
                                                    <TextBlock Text="WILL MOVE" Style="{StaticResource Overline}" />
                                                    <TextBlock Text="{Binding MoveCount}" AutomationProperties.AutomationId="MoveCount" FontSize="22" FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding MoveSize}" Style="{StaticResource TileCaption}" />
                                                </StackPanel>
                                            </Border>
                                            <Border>
                                                <StackPanel>
                                                    <TextBlock Text="STAYS" Style="{StaticResource Overline}" />
                                                    <TextBlock Text="{Binding StayCount}" AutomationProperties.AutomationId="StayCount" FontSize="20" FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding StaySize}" Style="{StaticResource TileCaption}" />
                                                </StackPanel>
                                            </Border>
                                            <Border>
                                                <StackPanel>
                                                    <TextBlock Text="HOW" Style="{StaticResource Overline}" />
                                                    <TextBlock Text="{Binding MethodTitle}" FontSize="20" FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding MethodDetail}" Style="{StaticResource TileCaption}" />
                                                </StackPanel>
                                            </Border>
                                            <Border>
                                                <StackPanel>
                                                    <DockPanel>
                                                        <Button DockPanel.Dock="Right" Content="Show" Style="{StaticResource LinkButton}" Command="{Binding ShowAttentionCommand}" Padding="2,0"
                                                                AutomationProperties.AutomationId="ShowAttentionButton" AutomationProperties.Name="Show the files that need a look"
                                                                Visibility="{Binding HasAttention, Converter={StaticResource VisibleWhen}}" VerticalAlignment="Top" />
                                                        <TextBlock Text="NEEDS A LOOK" Style="{StaticResource Overline}" />
                                                    </DockPanel>
                                                    <TextBlock Text="{Binding AttentionCount}" AutomationProperties.AutomationId="AttentionCount" FontSize="20" FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding AttentionDetail}" Style="{StaticResource TileCaption}" />
                                                </StackPanel>
                                            </Border>
                                        </UniformGrid>

                                        <!-- Warnings and errors: they must be read before confirming (the status line counts them) -->
                                        <ItemsControl ItemsSource="{Binding Alerts}" ItemTemplate="{StaticResource MessageTemplate}" Margin="2,0,0,6"
                                                      AutomationProperties.AutomationId="PlanAlerts" Visibility="{Binding ShowAlerts, Converter={StaticResource VisibleWhen}}" />

                                        <!-- Source picked inside a card structure: offer the folder that holds the whole card -->
                                        <Border Style="{StaticResource Card}" Padding="14,10" Margin="0,0,0,10" Visibility="{Binding HasSuggestedSource, Converter={StaticResource VisibleWhen}}">
                                            <DockPanel>
                                                <Button DockPanel.Dock="Right" Content="Use this folder" Command="{Binding UseSuggestedSourceCommand}" AutomationProperties.AutomationId="UseSuggestedSourceButton"
                                                        Style="{StaticResource ModeButton}" MinWidth="140" Margin="12,0,0,0" />
                                                <TextBlock VerticalAlignment="Center" TextWrapping="Wrap">
                                                    <Run Text="Sort the whole card instead:" />
                                                    <Run Text="{Binding SuggestedSource, Mode=OneWay}" FontWeight="SemiBold" />
                                                </TextBlock>
                                            </DockPanel>
                                        </Border>

                                        <!-- Notes about the preview: behind a link, opened on a click -->
                                        <local:InfoTip HorizontalAlignment="Left" Margin="0,0,0,8" PopupWidth="680" Label="{Binding NotesLabel}"
                                                       AutomationProperties.AutomationId="PlanNotes" AutomationProperties.Name="Good to know about this preview"
                                                       Visibility="{Binding ShowNotes, Converter={StaticResource VisibleWhen}}">
                                            <ItemsControl ItemsSource="{Binding Notes}" ItemTemplate="{StaticResource MessageTemplate}" AutomationProperties.AutomationId="PlanMessages" />
                                        </local:InfoTip>
                                    </StackPanel>
                                    </Grid>
                                </ScrollViewer>

                                <!-- On a short window: a visible hint that the upper part has more (warnings, notes) below. It floats
                                     over the text, so it is solid (the theme's button fill is see-through). -->
                                <Button HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,22,4" Padding="12,3" Click="MoreBelow_Click"
                                        Background="{DynamicResource SolidBackgroundFillColorQuarternaryBrush}" BorderBrush="{DynamicResource SurfaceStrokeColorFlyoutBrush}"
                                        AutomationProperties.AutomationId="MoreBelowButton" AutomationProperties.Name="Show more below"
                                        ToolTip="There is more above the lists - scroll down to read it">
                                    <Button.Visibility>
                                        <MultiBinding Converter="{StaticResource MoreBelow}">
                                            <Binding ElementName="UpperScroll" Path="VerticalOffset" />
                                            <Binding ElementName="UpperScroll" Path="ScrollableHeight" />
                                        </MultiBinding>
                                    </Button.Visibility>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="More below" FontSize="12" />
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE70D;" FontSize="10" Margin="6,1,0,0" />
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <!-- Lists: the preview, or after a job what is still in the source -->
                            <DockPanel Grid.Row="1" Margin="0,2,0,0" Visibility="{Binding ShowLists, Converter={StaticResource VisibleWhen}}">
                                <TextBlock DockPanel.Dock="Top" Text="{Binding ListsHeading}" AutomationProperties.AutomationId="ListsHeading" FontWeight="SemiBold" FontSize="15" Margin="0,2,0,4"
                                           Visibility="{Binding ListsHeading, Converter={StaticResource VisibleWhen}}" />
                                <Grid x:Name="ListsArea">
                                    <TabControl SelectedIndex="{Binding SelectedListTab}" AutomationProperties.AutomationId="PreviewTabs">
                                        <TabItem Header="{Binding MoveTabHeader}" AutomationProperties.AutomationId="MoveTab">
                                            <Grid Margin="0,6,0,0">
                                                <DataGrid Style="{StaticResource Grid}" ItemsSource="{Binding MoveView}" AutomationProperties.AutomationId="MoveList">
                                                    <DataGrid.Columns>
                                                        <DataGridTextColumn Header="Folder" Binding="{Binding Folder}" Width="3*" MinWidth="120" ElementStyle="{StaticResource CellText}" />
                                                        <DataGridTextColumn Header="File" Binding="{Binding Name}" Width="2*" MinWidth="120" ElementStyle="{StaticResource CellText}" />
                                                        <DataGridTextColumn Header="Type" Binding="{Binding Kind}" Width="Auto" MinWidth="100" ElementStyle="{StaticResource CellText}" />
                                                        <DataGridTextColumn Header="Size" Binding="{Binding Size}" SortMemberPath="SizeBytes" Width="Auto" MinWidth="76" ElementStyle="{StaticResource SizeCell}" />
                                                        <DataGridTextColumn Header="Why" Binding="{Binding Why}" Width="4*" MinWidth="240" ElementStyle="{StaticResource CellText}" />
                                                        <DataGridTextColumn Header="Note" Binding="{Binding Status}" Width="Auto" MinWidth="80" MaxWidth="280" ElementStyle="{StaticResource CellText}" />
                                                    </DataGrid.Columns>
                                                </DataGrid>
                                                <TextBlock Text="{Binding MoveListEmptyText}" AutomationProperties.AutomationId="MoveListEmpty" Style="{StaticResource Caption}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" Margin="16,32,16,0"
                                                           Visibility="{Binding MoveListEmptyText, Converter={StaticResource VisibleWhen}}" />
                                            </Grid>
                                        </TabItem>
                                        <TabItem Header="By folder" AutomationProperties.AutomationId="FolderTab" Visibility="{Binding HasPlan, Converter={StaticResource VisibleWhen}}">
                                            <DataGrid Style="{StaticResource Grid}" ItemsSource="{Binding FolderRows}" Margin="0,6,0,0">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Source folder" Binding="{Binding Folder}" Width="*" MinWidth="200" ElementStyle="{StaticResource CellText}" />
                                                    <DataGridTextColumn Header="Files moving" Binding="{Binding Moving, StringFormat=N0}" Width="Auto" ElementStyle="{StaticResource CellText}" />
                                                    <DataGridTextColumn Header="Size moving" Binding="{Binding MovingSize}" SortMemberPath="MovingBytes" Width="Auto" ElementStyle="{StaticResource SizeCell}" />
                                                    <DataGridTextColumn Header="Files staying" Binding="{Binding Staying, StringFormat=N0}" Width="Auto" ElementStyle="{StaticResource CellText}" />
                                                    <DataGridTextColumn Header="Note" Binding="{Binding Note}" Width="Auto" MinWidth="80" ElementStyle="{StaticResource CellText}" />
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </TabItem>
                                        <TabItem Header="By file type" AutomationProperties.AutomationId="TypeTab" Visibility="{Binding HasPlan, Converter={StaticResource VisibleWhen}}">
                                            <DataGrid Style="{StaticResource Grid}" ItemsSource="{Binding TypeRows}" Margin="0,6,0,0">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Action" Binding="{Binding Action}" Width="Auto" ElementStyle="{StaticResource CellText}" />
                                                    <DataGridTextColumn Header="Extension" Binding="{Binding Extension}" Width="Auto" ElementStyle="{StaticResource CellText}" />
                                                    <DataGridTextColumn Header="Classified as" Binding="{Binding Classification}" Width="*" MinWidth="160" ElementStyle="{StaticResource CellText}" />
                                                    <DataGridTextColumn Header="Files" Binding="{Binding Files, StringFormat=N0}" Width="Auto" ElementStyle="{StaticResource CellText}" />
                                                    <DataGridTextColumn Header="Size" Binding="{Binding Size}" SortMemberPath="Bytes" Width="Auto" ElementStyle="{StaticResource SizeCell}" />
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </TabItem>
                                        <TabItem Header="{Binding StayTabHeader}" AutomationProperties.AutomationId="StayTab" Visibility="{Binding HasPlan, Converter={StaticResource VisibleWhen}}">
                                            <DataGrid Style="{StaticResource Grid}" ItemsSource="{Binding StayView}" AutomationProperties.AutomationId="StayList" Margin="0,6,0,0">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Folder" Binding="{Binding Folder}" Width="3*" MinWidth="120" ElementStyle="{StaticResource CellText}" />
                                                    <DataGridTextColumn Header="File" Binding="{Binding Name}" Width="2*" MinWidth="120" ElementStyle="{StaticResource CellText}" />
                                                    <DataGridTextColumn Header="Type" Binding="{Binding Kind}" Width="Auto" MinWidth="100" ElementStyle="{StaticResource CellText}" />
                                                    <DataGridTextColumn Header="Size" Binding="{Binding Size}" SortMemberPath="SizeBytes" Width="Auto" MinWidth="76" ElementStyle="{StaticResource SizeCell}" />
                                                    <DataGridTextColumn Header="Why it stays" Binding="{Binding Why}" Width="4*" MinWidth="240" ElementStyle="{StaticResource CellText}" />
                                                    <DataGridTextColumn Header="Note" Binding="{Binding Status}" Width="Auto" MinWidth="80" MaxWidth="280" ElementStyle="{StaticResource CellText}" />
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </TabItem>
                                    </TabControl>

                                    <!-- Filter, next to the tab headers (it applies to the file lists) -->
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top"
                                                Visibility="{Binding ShowListFilter, Converter={StaticResource VisibleWhen}}">
                                        <TextBlock Text="Filter" VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <TextBox Text="{Binding ListFilter, UpdateSourceTrigger=PropertyChanged, Delay=250}" VerticalAlignment="Center"
                                                 Width="{Binding ActualWidth, ElementName=ListsArea, Converter={StaticResource ShrinkingWidth}, ConverterParameter='700,110,220'}"
                                                 AutomationProperties.AutomationId="ListFilterBox" AutomationProperties.Name="Filter the list"
                                                 ToolTip="Show only rows whose path, type, reason or note contains this text" />
                                        <CheckBox Content="Only files that need a look" IsChecked="{Binding AttentionOnly}" AutomationProperties.AutomationId="AttentionOnlyBox"
                                                  VerticalAlignment="Center" Margin="14,0,0,0" />
                                    </StackPanel>
                                </Grid>
                            </DockPanel>
                        </Grid>
                    </DockPanel>
                </TabItem>
            </TabControl>

            <!-- Next to the mode switch: how the open mode works, and on the Sort tab its undo -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Height="44">
                <Button Style="{StaticResource QuietButton}" Command="{Binding UndoPreviousCommand}" Margin="0,0,8,0"
                        AutomationProperties.AutomationId="UndoPreviousButton" AutomationProperties.Name="Undo a previous sort..."
                        ToolTip="Move the files of an earlier sort back where they came from"
                        Visibility="{Binding IsSortTab, Converter={StaticResource VisibleWhen}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE7A7;" FontSize="14" />
                        <TextBlock Text="Undo a sort..." Margin="7,0,3,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <local:InfoTip Label="How it works" PopupWidth="560" PopupAlignment="Right"
                               AutomationProperties.AutomationId="BackupHowItWorks" AutomationProperties.Name="How Backup works"
                               Visibility="{Binding IsBackupTab, Converter={StaticResource VisibleWhen}}">
                    <StackPanel>
                        <TextBlock Text="Backup" Style="{StaticResource PopupHeading}" />
                        <TextBlock Text="{x:Static local:BackupTexts.BackupDescription}" TextWrapping="Wrap" LineHeight="20" />
                        <TextBlock Style="{StaticResource PopupStep}" Text="1.  Check card only reads the card. Nothing is copied until you start, and the card is never written to - it also works with the write-protect switch on." />
                        <TextBlock Style="{StaticResource PopupStep}" Text="2.  Every file is copied, exactly as it is: all folders (empty ones too), hidden files and camera metadata, with their dates. Only folders Windows and macOS keep on every drive are left out." />
                        <TextBlock Style="{StaticResource PopupStep}" Text="3.  The card is read once and written to every destination at the same time. Each copy is read back from its own drive and compared by SHA-256, and the card file is read a second time; only then does a copy count as verified. If one destination fails, the others go on." />
                        <TextBlock Style="{StaticResource PopupStep}" Text="4.  ASC MHL checksum files are written into each backup folder, so Hedge, Silverstack or the ascmhl tool can check it independently." />
                        <TextBlock Style="{StaticResource PopupStep}">
                            <Run Text="5.  Nothing is ever overwritten. Every step is logged in each backup's" />
                            <Run Text="{x:Static jobs:JobPaths.LogFolderName}" />
                            <Run Text="folder, so a backup that is stopped, crashes, loses power or has a drive unplugged resumes exactly where it was." />
                        </TextBlock>
                    </StackPanel>
                </local:InfoTip>

                <local:InfoTip Label="How it works" PopupWidth="560" PopupAlignment="Right"
                               AutomationProperties.AutomationId="SortHowItWorks" AutomationProperties.Name="How Sort works"
                               Visibility="{Binding IsSortTab, Converter={StaticResource VisibleWhen}}">
                    <StackPanel>
                        <TextBlock Text="Sort" Style="{StaticResource PopupHeading}" />
                        <TextBlock Text="{x:Static local:BackupTexts.SortDescription}" TextWrapping="Wrap" LineHeight="20" />
                        <TextBlock Style="{StaticResource PopupStep}" Text="1.  Check folder only reads the folder. Nothing is moved until you confirm." />
                        <TextBlock Style="{StaticResource PopupStep}" Text="2.  The preview lists every file that will move and why - including companion files such as DJI .LRF/.SRT, sidecars and XMP files - and everything that stays. Card folders (Sony PRIVATE, P2, XF, RED...) and CinemaDNG clips move as a whole." />
                        <TextBlock Style="{StaticResource PopupStep}" Text="3.  Files keep their sub-folders: Shoot\DCIM\100MEDIA\DJI_0003.MOV goes to Target\Shoot\DCIM\100MEDIA\DJI_0003.MOV." />
                        <TextBlock Style="{StaticResource PopupStep}" Text="4.  On the same drive files are renamed into place (their data is never rewritten). Between drives each file is copied and read back from disk, the original is read a second time, and only when both match by SHA-256 is the original removed." />
                        <TextBlock Style="{StaticResource PopupStep}">
                            <Run Text="5.  Nothing is ever overwritten. Every step is logged in the target's" />
                            <Run Text="{x:Static jobs:JobPaths.LogFolderName}" />
                            <Run Text="folder and a receipt is left in the source, so a job that is stopped, crashes or loses power resumes exactly where it was - and any sort can be undone." />
                        </TextBlock>
                    </StackPanel>
                </local:InfoTip>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
