<Window x:Class="IvarOffload.App.UndoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:IvarOffload.App"
        Title="Undo a previous sort - IVAR Offload" Icon="app.ico" Width="1040" Height="560" MinWidth="720" MinHeight="400"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource ApplicationBackgroundBrush}" Foreground="{DynamicResource TextFillColorPrimaryBrush}"
        AutomationProperties.AutomationId="UndoWindow">
    <DockPanel Margin="24,18,24,20">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <TextBlock Text="Undo a previous sort" FontSize="20" FontWeight="SemiBold" />
            <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0"
                       Text="Pick a sort to move its files back where they came from. The list shows the sorts this PC remembers; to find others, choose the folder that was sorted, or open its job log or the receipt left in the folder the files came from." />
        </StackPanel>

        <DockPanel DockPanel.Dock="Bottom" Margin="0,14,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="Undo selected..." Command="{Binding UndoCommand}" AutomationProperties.AutomationId="UndoSelectedButton"
                        Style="{DynamicResource AccentButtonStyle}" MinWidth="150" Height="34" Margin="0,0,8,0" IsDefault="True" />
                <Button Content="Cancel" AutomationProperties.AutomationId="UndoCancelButton" MinWidth="100" Height="34" IsCancel="True" />
            </StackPanel>
            <TextBlock Text="{Binding SelectionNote}" AutomationProperties.AutomationId="UndoSelectionNote" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,16,0" />
        </DockPanel>

        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <Button Content="Choose a folder..." Command="{Binding ChooseFolderCommand}" AutomationProperties.AutomationId="UndoChooseFolderButton" MinWidth="150" Margin="0,0,8,0" />
            <Button Content="Open a log file..." Command="{Binding OpenLogCommand}" AutomationProperties.AutomationId="UndoOpenLogButton" MinWidth="150" Margin="0,0,16,0"
                    ToolTip="A job log (.journal.jsonl) from the sorted folder's log folder, or a receipt (.moved-out) from the folder the files came from" />
            <ProgressBar IsIndeterminate="True" Width="60" Height="4" Margin="0,0,10,0" Visibility="{Binding IsBusy, Converter={StaticResource VisibleWhen}}" />
            <TextBlock Text="{Binding Status}" Style="{StaticResource Caption}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
        </DockPanel>

        <DataGrid Style="{StaticResource Grid}" ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected}" SelectionMode="Single"
                  AutomationProperties.AutomationId="UndoList" MouseDoubleClick="OnDoubleClick">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Date" Binding="{Binding Date}" SortMemberPath="Job.Created" Width="Auto" ElementStyle="{StaticResource CellText}" />
                <DataGridTextColumn Header="Moved" Binding="{Binding What}" Width="Auto" ElementStyle="{StaticResource CellText}" />
                <DataGridTextColumn Header="From" Binding="{Binding From}" Width="*" ElementStyle="{StaticResource CellText}" />
                <DataGridTextColumn Header="To" Binding="{Binding To}" Width="*" ElementStyle="{StaticResource CellText}" />
                <DataGridTextColumn Header="Files" Binding="{Binding Files}" SortMemberPath="Job.Moved" Width="Auto" ElementStyle="{StaticResource SizeCell}" />
                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="Auto" MinWidth="110" ElementStyle="{StaticResource CellText}" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
