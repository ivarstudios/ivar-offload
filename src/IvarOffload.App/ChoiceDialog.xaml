<Window x:Class="IvarOffload.App.ChoiceDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="520" SizeToContent="Height" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" Icon="app.ico"
        Background="{DynamicResource ApplicationBackgroundBrush}" Foreground="{DynamicResource TextFillColorPrimaryBrush}"
        AutomationProperties.AutomationId="ChoiceDialog">
    <DockPanel Margin="24,20,24,20">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button x:Name="PrimaryButton" AutomationProperties.AutomationId="ChoicePrimaryButton" Style="{DynamicResource AccentButtonStyle}"
                    MinWidth="130" Margin="0,0,8,0" IsDefault="True" Click="OnPrimary" />
            <Button x:Name="SecondaryButton" AutomationProperties.AutomationId="ChoiceSecondaryButton" MinWidth="130" Click="OnSecondary" />
        </StackPanel>
        <TextBlock DockPanel.Dock="Left" Style="{StaticResource Icon}" Text="&#xE7BA;" FontSize="26" VerticalAlignment="Top" Margin="0,2,16,0"
                   Foreground="{DynamicResource SystemFillColorCautionBrush}" />
        <StackPanel>
            <TextBlock x:Name="HeadingText" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,8" />
            <TextBlock x:Name="MessageText" TextWrapping="Wrap" AutomationProperties.AutomationId="ChoiceMessage" />
        </StackPanel>
    </DockPanel>
</Window>
