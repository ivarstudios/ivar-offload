<UserControl x:Class="IvarOffload.App.BackupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:IvarOffload.App"
             >
    <UserControl.Resources>
        <!-- The Backup colour for everything accented on this tab: buttons, progress bars, check boxes. -->
        <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#0B7A66" />
        <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#0B7A66" Opacity="0.9" />
        <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#0B7A66" Opacity="0.8" />
        <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#12A38A" />
        <SolidColorBrush x:Key="ModeAccentBrush" Color="#0B7A66" />

        <DataTemplate x:Key="MessageTemplate" DataType="{x:Type local:MessageRow}">
            <DockPanel Margin="0,0,0,6">
                <TextBlock x:Name="icon" Style="{StaticResource Icon}" Text="{Binding Icon}" VerticalAlignment="Top" Margin="0,2,10,0"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <TextBlock Text="{Binding Text}" TextWrapping="Wrap" />
            </DockPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Level}" Value="Warning">
                    <Setter TargetName="icon" Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Level}" Value="Error">
                    <Setter TargetName="icon" Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <DockPanel Margin="0,36,0,0">

        <!-- Action bar: always visible -->
        <Border DockPanel.Dock="Bottom" Margin="0,16,0,0" Padding="0,18,0,0" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.ColumnSpan="2" HorizontalAlignment="Right" Margin="0,0,0,8" Visibility="{Binding ShowStart, Converter={StaticResource VisibleWhen}}">
                    <!-- Copies that are not on drives of their own: said here, next to Start, where no scrolling can hide it -->
                    <DockPanel HorizontalAlignment="Right" Margin="0,0,0,4" Visibility="{Binding HasStartWarn, Converter={StaticResource VisibleWhen}}">
                        <TextBlock DockPanel.Dock="Left" Style="{StaticResource Icon}" Text="&#xE7BA;" Margin="0,0,8,0" VerticalAlignment="Top"
                                   Foreground="{DynamicResource SystemFillColorCautionBrush}" />
                        <TextBlock Text="{Binding StartWarn}" AutomationProperties.AutomationId="BackupStartWarn" FontWeight="SemiBold"
                                   TextWrapping="Wrap" TextAlignment="Right" Foreground="{DynamicResource SystemFillColorCautionBrush}" />
                    </DockPanel>
                    <TextBlock Text="{Binding StartLine}" AutomationProperties.AutomationId="BackupStartLine" FontWeight="Bold"
                               TextWrapping="Wrap" TextAlignment="Right" HorizontalAlignment="Right" />
                </StackPanel>

                <StackPanel Grid.Row="1" VerticalAlignment="Center">
                    <StackPanel Visibility="{Binding ShowProgress, Converter={StaticResource VisibleWhen}}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Text="{Binding ProgressRight}" Style="{StaticResource Caption}" Margin="12,0,0,0" />
                            <TextBlock Text="{Binding ProgressLeft}" AutomationProperties.AutomationId="BackupProgressText" />
                        </DockPanel>
                        <ProgressBar Value="{Binding Progress, Mode=OneWay}" Maximum="1" Height="6" Margin="0,8,0,6" Foreground="{StaticResource BackupAccent}" />
                        <TextBlock Text="{Binding ProgressFile}" Style="{StaticResource Caption}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <DockPanel Visibility="{Binding ShowProgress, Converter={StaticResource VisibleWhen}, ConverterParameter=invert}">
                        <ProgressBar DockPanel.Dock="Left" IsIndeterminate="True" Width="80" Height="4" Margin="0,0,12,0"
                                     Visibility="{Binding IsBusy, Converter={StaticResource VisibleWhen}}" />
                        <TextBlock Text="{Binding Status}" AutomationProperties.AutomationId="BackupStatus" TextWrapping="Wrap" VerticalAlignment="Center" />
                    </DockPanel>
                    <TextBlock Text="{Binding Status}" Style="{StaticResource Caption}" Margin="0,4,0,0" TextWrapping="Wrap"
                               Visibility="{Binding IsPaused, Converter={StaticResource VisibleWhen}}" />
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <Button Content="{Binding PauseText}" Command="{Binding PauseCommand}" AutomationProperties.AutomationId="BackupPauseButton" MinWidth="100" Height="34" Margin="0,0,8,0"
                            Visibility="{Binding ShowPause, Converter={StaticResource VisibleWhen}}"
                            ToolTip="Pauses between steps. Do not unplug the card or the drives while paused - press Stop first." />
                    <Button Content="Stop" Command="{Binding StopCommand}" AutomationProperties.AutomationId="BackupStopButton" MinWidth="100" Height="34"
                            Visibility="{Binding ShowStop, Converter={StaticResource VisibleWhen}}"
                            ToolTip="Stops safely: the copy in progress is finished or removed. Then it is safe to unplug, and the backup can be resumed." />
                    <Button Command="{Binding StartCommand}" AutomationProperties.AutomationId="BackupStartButton" AutomationProperties.Name="Start backup"
                            Style="{StaticResource ModeButton}" MinWidth="230" Height="38"
                            Visibility="{Binding ShowStart, Converter={StaticResource VisibleWhen}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE8C8;" Margin="0,0,8,0" />
                            <TextBlock Text="{Binding StartText}" FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer x:Name="BackupScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" AutomationProperties.AutomationId="BackupArea">
            <!-- Before a scan the setup is the whole page: centred in the height, so the space above and below it grows with the window -->
            <Grid MinHeight="{Binding ViewportHeight, ElementName=BackupScroll}">
            <StackPanel Style="{StaticResource CentredWhileSetup}">

                <!-- Result -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,20" Visibility="{Binding HasResult, Converter={StaticResource VisibleWhen}}"
                        AutomationProperties.AutomationId="BackupResultCard">
                    <DockPanel>
                        <Grid DockPanel.Dock="Left" Margin="0,2,14,0" VerticalAlignment="Top" Width="24">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE73E;" FontSize="22" Foreground="{DynamicResource SystemFillColorSuccessBrush}"
                                       AutomationProperties.AutomationId="BackupResultGoodIcon" AutomationProperties.Name="Every file verified"
                                       Visibility="{Binding ResultIsGood, Converter={StaticResource VisibleWhen}}" />
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE7BA;" FontSize="22" Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                       AutomationProperties.AutomationId="BackupResultWarningIcon" AutomationProperties.Name="Needs attention"
                                       Visibility="{Binding ResultIsAttention, Converter={StaticResource VisibleWhen}}" />
                        </Grid>
                        <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                            <!-- The common next steps; the rest behind "More" -->
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="Done" Command="{Binding NewBackupCommand}" AutomationProperties.AutomationId="BackupNewButton"
                                        Style="{StaticResource ModeButton}" MinWidth="110" Margin="8,4,0,0" ToolTip="Back to the start, for the next card" />
                                <WrapPanel>
                                    <WrapPanel.Resources>
                                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                            <Setter Property="Margin" Value="0,4,8,0" />
                                        </Style>
                                    </WrapPanel.Resources>
                                    <Button Content="Open backup folder" Command="{Binding OpenDestinationCommand}" AutomationProperties.AutomationId="BackupOpenButton" MinWidth="150" />
                                    <Button Content="Sort this backup..." Command="{Binding SortThisCommand}" AutomationProperties.AutomationId="BackupSortButton" MinWidth="150"
                                            Visibility="{Binding CanSortThisNow, Converter={StaticResource VisibleWhen}}"
                                            ToolTip="Opens the Sort tab with this backup folder, to move its videos or photos into a folder of their own" />
                                    <ToggleButton IsChecked="{Binding ShowMore}" Margin="0,4,8,0" Padding="12,5" AutomationProperties.AutomationId="BackupMoreButton"
                                                  AutomationProperties.Name="More actions">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="More" />
                                            <TextBlock Style="{StaticResource Icon}" Text="&#xE70D;" FontSize="10" Margin="6,1,0,0" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </ToggleButton>
                                </WrapPanel>
                            </DockPanel>
                            <WrapPanel Margin="0,4,0,0" Visibility="{Binding ShowMore, Converter={StaticResource VisibleWhen}}">
                                <WrapPanel.Resources>
                                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                        <Setter Property="Margin" Value="0,4,8,0" />
                                    </Style>
                                </WrapPanel.Resources>
                                <Button Content="Check the copies again" Command="{Binding VerifyCommand}" AutomationProperties.AutomationId="BackupVerifyButton" MinWidth="170"
                                        ToolTip="Reads every copy on every backup drive again and compares it with the card's files as they were copied" />
                                <Button Content="Open report" Command="{Binding OpenLogCommand}" AutomationProperties.AutomationId="BackupLogButton" MinWidth="110"
                                        ToolTip="The list of every file copied, and how it was checked" />
                                <Button Content="Sort this backup..." Command="{Binding SortThisCommand}" AutomationProperties.AutomationId="BackupSortMoreButton" MinWidth="150"
                                        Visibility="{Binding CanSortThisLater, Converter={StaticResource VisibleWhen}}"
                                        ToolTip="Opens the Sort tab with this backup folder. Sorting moves files out of the backup." />
                            </WrapPanel>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="{Binding ResultTitle}" AutomationProperties.AutomationId="BackupResultTitle" FontWeight="SemiBold" FontSize="16" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding ResultAlarm}" AutomationProperties.AutomationId="BackupResultAlarm" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,6,0,0"
                                       Foreground="{DynamicResource SystemFillColorCriticalBrush}" Visibility="{Binding ResultAlarm, Converter={StaticResource VisibleWhen}}" />
                            <TextBlock Text="{Binding ResultLeftLine}" AutomationProperties.AutomationId="BackupResultLeftLine" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,6,0,0"
                                       Visibility="{Binding ResultLeftLine, Converter={StaticResource VisibleWhen}}" />
                            <ItemsControl ItemsSource="{Binding ResultReasons}" AutomationProperties.AutomationId="BackupResultReasons" Margin="0,4,0,0"
                                          Visibility="{Binding HasResultReasons, Converter={StaticResource VisibleWhen}}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,1,0,0">
                                            <TextBlock DockPanel.Dock="Left" Text="•" Style="{StaticResource Caption}" Margin="4,0,8,0" />
                                            <TextBlock Text="{Binding}" Style="{StaticResource Caption}" />
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="{Binding ResultDetail}" AutomationProperties.AutomationId="BackupResultDetail" Style="{StaticResource Caption}" Margin="0,6,0,0"
                                       Visibility="{Binding ResultDetail, Converter={StaticResource VisibleWhen}}" />
                            <Expander Header="Details" Margin="0,8,0,0" AutomationProperties.AutomationId="BackupResultTechnical"
                                      Visibility="{Binding HasResultTechnical, Converter={StaticResource VisibleWhen}}">
                                <ItemsControl ItemsSource="{Binding ResultTechnical}" Margin="0,4,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" Style="{StaticResource Caption}" Margin="0,1,0,0" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Expander>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- Unfinished backup -->
                <Border Margin="0,0,0,20" Padding="20,16" CornerRadius="8" BorderThickness="1"
                        Background="{DynamicResource SystemFillColorCautionBackgroundBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        Visibility="{Binding HasBanner, Converter={StaticResource VisibleWhen}}" AutomationProperties.AutomationId="BackupBanner">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Left" Style="{StaticResource Icon}" Text="&#xE7BA;" FontSize="20" VerticalAlignment="Top" Margin="0,2,14,0"
                                   Foreground="{DynamicResource SystemFillColorCautionBrush}" />
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0"
                                    Visibility="{Binding BannerOffline, Converter={StaticResource VisibleWhen}, ConverterParameter=invert}">
                            <Button Content="Resume" Command="{Binding ResumeCommand}" AutomationProperties.AutomationId="BackupResumeButton" Style="{StaticResource ModeButton}" MinWidth="110" Margin="0,0,8,0" />
                            <Button Content="Stop here..." Command="{Binding CloseJobCommand}" AutomationProperties.AutomationId="BackupEndButton" MinWidth="110"
                                    ToolTip="Ends this backup and keeps what is copied. Nothing is deleted. The card is not needed for this." />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="{Binding BannerTitle}" AutomationProperties.AutomationId="BackupBannerTitle" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding BannerText}" Style="{StaticResource Caption}" Margin="0,2,0,0" />
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0" Visibility="{Binding BannerOffline, Converter={StaticResource VisibleWhen}}">
                                <Button Content="Check again" Style="{StaticResource LinkButton}" Command="{Binding RecheckCommand}" AutomationProperties.AutomationId="BackupRecheckButton" Margin="0,0,18,0" />
                                <Button Content="Forget this backup" Style="{StaticResource LinkButton}" Command="{Binding ForgetCommand}" AutomationProperties.AutomationId="BackupForgetButton" />
                            </StackPanel>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- Setup: the card on the left, the destinations on the right - the way the files travel -->
                <Grid Margin="0,0,0,24" Visibility="{Binding IsSetupFull, Converter={StaticResource VisibleWhen}}"
                      AutomationProperties.AutomationId="BackupSetupCard" IsEnabled="{Binding CanEditInputs}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="{StaticResource TravelColumn}" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- From: the card -->
                    <Border Style="{StaticResource SidePanel}">
                        <StackPanel>
                            <TextBlock Text="FROM" Style="{StaticResource SideLabel}" />
                            <DockPanel Margin="0,0,0,14">
                                <local:InfoTip DockPanel.Dock="Right" AutomationProperties.Name="About what to back up"
                                               Content="The memory card, a camera drive or any folder. It is only read, never changed." />
                                <TextBlock Text="What to back up" Style="{StaticResource FieldTitle}" />
                            </DockPanel>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="Browse..." Command="{Binding BrowseSourceCommand}" AutomationProperties.AutomationId="BackupBrowseSource" MinWidth="100" />
                                <TextBox Margin="0,0,8,0" AutomationProperties.AutomationId="BackupSourceBox" AutomationProperties.Name="What to back up" VerticalContentAlignment="Center"
                                         Text="{Binding SourcePath, UpdateSourceTrigger=PropertyChanged, Delay=500}" />
                            </DockPanel>
                            <TextBlock Text="{Binding SourceInfo}" AutomationProperties.AutomationId="BackupSourceInfo" Style="{StaticResource Caption}" Margin="2,6,0,0"
                                       Visibility="{Binding SourceInfo, Converter={StaticResource VisibleWhen}}" />
                            <WrapPanel Margin="0,14,0,0">
                                <ItemsControl ItemsSource="{Binding Cards}" AutomationProperties.AutomationId="BackupCards">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type local:CardChoice}">
                                            <Button Command="{Binding DataContext.PickCardCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"
                                                    AutomationProperties.AutomationId="{Binding Id}" AutomationProperties.Name="{Binding Name}" Margin="0,0,8,6" Padding="12,5"
                                                    ToolTip="{Binding Detail}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE7F1;" Margin="0,0,8,0" />
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding Camera}" Margin="8,0,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                               Visibility="{Binding HasCamera, Converter={StaticResource VisibleWhen}}" />
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="Insert a card, or choose a folder." Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="2,0,10,6"
                                           Visibility="{Binding ShowNoCard, Converter={StaticResource VisibleWhen}}" />
                                <Button Style="{StaticResource QuietButton}" Command="{Binding RefreshCardsCommand}" Margin="0,0,0,6"
                                        AutomationProperties.AutomationId="BackupRefreshCards" AutomationProperties.Name="Look for cards" ToolTip="Look for connected cards again">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE72C;" FontSize="13" />
                                        <TextBlock Text="Look for cards" Margin="7,0,3,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <!-- The arrow -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Style="{StaticResource TravelArrow}" />
                        <TextBlock Text="copy" Style="{StaticResource Caption}" HorizontalAlignment="Center" Margin="0,6,0,0" />
                    </StackPanel>

                    <!-- To: the destinations and the backup's folder name -->
                    <Border Grid.Column="2" Style="{StaticResource SidePanel}">
                        <StackPanel>
                            <TextBlock Text="TO" Style="{StaticResource SideLabel}" />
                            <DockPanel Margin="0,0,0,14">
                                <local:InfoTip DockPanel.Dock="Right" AutomationProperties.Name="About where to save the copies"
                                               Content="One to three backup drives. Use a different drive for each copy, so one broken drive can't take them all. A new folder is made on each (its name is below)." />
                                <TextBlock Text="Where to save the copies" Style="{StaticResource FieldTitle}" />
                            </DockPanel>
                            <ItemsControl ItemsSource="{Binding Destinations}" AutomationProperties.AutomationId="BackupDestinations">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type local:DestinationSlot}">
                                        <StackPanel Margin="0,0,0,8">
                                            <DockPanel>
                                                <Button DockPanel.Dock="Right" Command="{Binding RemoveCommand}" AutomationProperties.AutomationId="{Binding RemoveId}"
                                                        AutomationProperties.Name="Remove this backup drive" ToolTip="Remove this backup drive" Margin="6,0,0,0" Padding="8,4"
                                                        Visibility="{Binding CanRemove, Converter={StaticResource VisibleWhen}}">
                                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE74D;" FontSize="12" />
                                                </Button>
                                                <Button DockPanel.Dock="Right" Content="Browse..." Command="{Binding BrowseCommand}" AutomationProperties.AutomationId="{Binding BrowseId}" MinWidth="100" />
                                                <TextBox Margin="0,0,8,0" AutomationProperties.AutomationId="{Binding BoxId}" AutomationProperties.Name="{Binding Label}" VerticalContentAlignment="Center"
                                                         Text="{Binding Path, UpdateSourceTrigger=PropertyChanged, Delay=500}" />
                                            </DockPanel>
                                            <!-- The same folder twice, or a drive that is not a separate copy: said right here, before the check -->
                                            <DockPanel Margin="2,4,0,0" Visibility="{Binding HasProblem, Converter={StaticResource VisibleWhen}}">
                                                <TextBlock x:Name="ProblemIcon" DockPanel.Dock="Left" Style="{StaticResource Icon}" Text="&#xE7BA;" FontSize="12" Margin="0,2,6,0"
                                                           Foreground="{DynamicResource SystemFillColorCautionBrush}" />
                                                <TextBlock x:Name="ProblemText" Text="{Binding Problem}" TextWrapping="Wrap" FontSize="13"
                                                           Foreground="{DynamicResource SystemFillColorCautionBrush}" />
                                            </DockPanel>
                                        </StackPanel>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding ProblemIsError}" Value="True">
                                                <Setter TargetName="ProblemIcon" Property="Text" Value="&#xEA39;" />
                                                <Setter TargetName="ProblemIcon" Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                                <Setter TargetName="ProblemText" Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button Style="{StaticResource QuietButton}" Command="{Binding AddDestinationCommand}" HorizontalAlignment="Left" Margin="-5,0,0,0"
                                    AutomationProperties.AutomationId="BackupAddDestination" AutomationProperties.Name="Add another backup drive (up to 3)"
                                    Visibility="{Binding CanAddDestination, Converter={StaticResource VisibleWhen}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE710;" FontSize="13" />
                                    <TextBlock Text="Add another drive (up to 3)" Margin="7,0,3,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <DockPanel Margin="0,20,0,8">
                                <local:InfoTip DockPanel.Dock="Right" AutomationProperties.Name="About the folder name"
                                               Content="The new folder the card is copied into on each backup drive: made from the choice below, with your description at the end. It must be new or empty." />
                                <TextBlock Text="New folder name" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </DockPanel>
                            <!-- The name is always made from the choice in the list, with the description added; "Saved as" shows the result -->
                            <DockPanel Margin="0,0,0,8">
                                <TextBlock DockPanel.Dock="Left" Text="Made from" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="2,0,10,0" Width="86" />
                                <ComboBox ItemsSource="{Binding NamePresets}" SelectedItem="{Binding SelectedPreset}" AutomationProperties.AutomationId="BackupNamePresets"
                                          AutomationProperties.Name="Make the folder name from" ToolTip="Choosing one fills in the folder name below. It is remembered for every backup.">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate DataType="{x:Type local:NamePreset}">
                                            <DockPanel>
                                                <TextBlock x:Name="Example" DockPanel.Dock="Right" Text="{Binding Example}" Style="{StaticResource Caption}" Margin="16,0,0,0" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding Label}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                            </DockPanel>
                                            <!-- Closed, the box shows only the choice: its result is in the name box right below -->
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ComboBoxItem}}" Value="{x:Null}">
                                                    <Setter TargetName="Example" Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </DockPanel>
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Left" Text="Description" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="2,0,10,0" Width="86" />
                                <TextBox AutomationProperties.AutomationId="BackupDescriptionBox" AutomationProperties.Name="Description (optional)" VerticalContentAlignment="Center"
                                         Text="{Binding Description, UpdateSourceTrigger=PropertyChanged, Delay=150}"
                                         ToolTip="Optional: added to the end of the folder name, e.g. KebnekaiseFlight" />
                            </DockPanel>
                            <!-- Right under the name: the folder it makes on every backup drive, as it will be -->
                            <StackPanel Margin="2,6,0,0" Visibility="{Binding HasWhereLine, Converter={StaticResource VisibleWhen}}">
                                <TextBlock Text="Saved as" Style="{StaticResource Caption}" />
                                <TextBlock Text="{Binding WhereLine}" AutomationProperties.AutomationId="BackupWhereLine" Margin="0,2,0,0"
                                           TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding WhereLine}" />
                            </StackPanel>
                            <Button Content="Your own pattern..." Style="{StaticResource LinkButton}" Command="{Binding ToggleTemplateCommand}"
                                    HorizontalAlignment="Left" Margin="2,6,0,0"
                                    AutomationProperties.AutomationId="BackupTemplateLink" AutomationProperties.Name="Your own name pattern"
                                    ToolTip="Make every new folder name from a pattern of your own" />
                            <!-- A pattern of your own: opened from the link, remembered for every backup -->
                            <Border Style="{StaticResource Card}" Padding="14,10" Margin="0,8,0,0" Visibility="{Binding ShowTemplate, Converter={StaticResource VisibleWhen}}"
                                    AutomationProperties.AutomationId="BackupTemplatePanel">
                                <StackPanel>
                                    <TextBlock Text="Your own pattern" FontWeight="SemiBold" Margin="0,0,0,6" />
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Content="Reset" Command="{Binding ResetTemplateCommand}" AutomationProperties.AutomationId="BackupTemplateReset"
                                                MinWidth="70" Margin="8,0,0,0" ToolTip="Back to the date and the card's name" />
                                        <TextBox AutomationProperties.AutomationId="BackupTemplateBox" AutomationProperties.Name="Your own name pattern" VerticalContentAlignment="Center"
                                                 Text="{Binding NameTemplate, UpdateSourceTrigger=PropertyChanged, Delay=500}" />
                                    </DockPanel>
                                    <TextBlock Text="{Binding TemplateError}" AutomationProperties.AutomationId="BackupTemplateError" TextWrapping="Wrap" Margin="2,6,0,0"
                                               Foreground="{DynamicResource SystemFillColorCriticalBrush}" Visibility="{Binding HasTemplateError, Converter={StaticResource VisibleWhen}}" />
                                    <TextBlock Text="{Binding TemplateExample}" AutomationProperties.AutomationId="BackupTemplateExample" Style="{StaticResource Caption}" FontWeight="SemiBold"
                                               Margin="2,6,0,0" TextWrapping="Wrap" />
                                    <local:InfoTip HorizontalAlignment="Left" Margin="-5,2,0,0" PopupWidth="460" Label="What can go in a pattern"
                                                   AutomationProperties.Name="What can go in a pattern">
                                        <TextBlock Text="{Binding TemplateHelp}" TextWrapping="Wrap" LineHeight="20" />
                                    </local:InfoTip>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <DockPanel Grid.Row="1" Grid.ColumnSpan="3" Margin="0,24,0,0">
                        <Button DockPanel.Dock="Right" Command="{Binding ScanCommand}" AutomationProperties.AutomationId="BackupScanButton" AutomationProperties.Name="Check card"
                                Style="{StaticResource ModeButton}" MinWidth="190" Height="38"
                                ToolTip="Reads the card and shows what will be copied. Nothing is copied yet.">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE721;" Margin="0,0,8,0" />
                                <TextBlock Text="Check card" />
                            </StackPanel>
                        </Button>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <CheckBox Content="Read the card twice" IsChecked="{Binding Reread}" VerticalAlignment="Center"
                                      AutomationProperties.AutomationId="BackupRereadBox" AutomationProperties.Name="Read the card twice" />
                            <local:InfoTip Margin="2,0,0,0" AutomationProperties.Name="About reading the card twice"
                                           Content="Reads every file on the card a second time, to catch a faulty card or card reader. Slower, and safer. Each copy is always checked either way." />
                        </StackPanel>
                    </DockPanel>
                </Grid>

                <!-- Setup, while running and after: one line, still from left to right -->
                <Border Style="{StaticResource Card}" Padding="20,12" Margin="0,0,0,20" Visibility="{Binding IsSetupCompact, Converter={StaticResource VisibleWhen}}"
                        AutomationProperties.AutomationId="BackupSetupSummary">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="{StaticResource TravelColumn}" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}">
                            <Run Text="{Binding SummaryVerb, Mode=OneWay}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <Run Text="{Binding SummarySource, Mode=OneWay}" FontWeight="SemiBold" />
                        </TextBlock>
                        <TextBlock Grid.Column="1" Style="{StaticResource TravelArrow}" FontSize="18" />
                        <DockPanel Grid.Column="2">
                            <Button DockPanel.Dock="Right" Content="Change" Command="{Binding ChangeSetupCommand}" AutomationProperties.AutomationId="BackupChangeSetupButton"
                                    MinWidth="90" Margin="16,0,0,0" ToolTip="Change the card, the destinations or the folder name"
                                    Visibility="{Binding ShowChangeSetup, Converter={StaticResource VisibleWhen}}" />
                            <TextBlock Text="{Binding SummaryWhere}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                                       ToolTip="{Binding SummaryWhere}" />
                        </DockPanel>
                    </Grid>
                </Border>

                <!-- While running: each destination -->
                <ItemsControl ItemsSource="{Binding DestinationProgress}" AutomationProperties.AutomationId="BackupDestinationProgress" Margin="0,0,0,10"
                              Visibility="{Binding ShowProgress, Converter={StaticResource VisibleWhen}}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type local:DestinationProgressRow}">
                            <Border Style="{StaticResource Card}" Padding="14,10" Margin="0,0,0,8">
                                <StackPanel>
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding Text}" Style="{StaticResource Caption}" Margin="12,0,0,0" MaxWidth="560" />
                                        <TextBlock FontWeight="SemiBold" TextTrimming="CharacterEllipsis">
                                            <Run Text="{Binding Drive, Mode=OneWay}" />
                                            <Run Text="{Binding Folder, Mode=OneWay}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontWeight="Normal" />
                                        </TextBlock>
                                    </DockPanel>
                                    <ProgressBar Value="{Binding Fraction, Mode=OneWay}" Maximum="1" Height="4" Margin="0,8,0,0" Foreground="{StaticResource BackupAccent}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Preview -->
                <StackPanel Visibility="{Binding ShowPreview, Converter={StaticResource VisibleWhen}}" AutomationProperties.AutomationId="BackupPreview">
                    <!-- The card was backed up before, to every destination: add its new files to that backup, or make a new full one -->
                    <Border Style="{StaticResource Card}" Margin="0,0,0,16" Padding="20,16" AutomationProperties.AutomationId="BackupTopUpCard"
                            Visibility="{Binding HasTopUpOffer, Converter={StaticResource VisibleWhen}}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Left" Style="{StaticResource Icon}" Text="&#xE81C;" FontSize="20" VerticalAlignment="Top" Margin="0,2,14,0"
                                       Foreground="{StaticResource BackupAccent}" />
                            <StackPanel>
                                <TextBlock Text="This card was backed up before" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding TopUpText}" AutomationProperties.AutomationId="BackupTopUpText" TextWrapping="Wrap" Margin="0,4,0,0" />
                                <WrapPanel Margin="0,12,0,0">
                                    <RadioButton Style="{StaticResource ChoicePill}" GroupName="BackupKind" IsChecked="{Binding UseTopUp}" Margin="0,0,8,4"
                                                 AutomationProperties.AutomationId="BackupTopUpChoice" AutomationProperties.Name="Add to that backup"
                                                 Content="Add the new files to that backup"
                                                 ToolTip="Only what is not in that backup is copied, then the whole card is checked against it. Nothing in it is overwritten or deleted." />
                                    <RadioButton Style="{StaticResource ChoicePill}" GroupName="BackupKind" IsChecked="{Binding UseFullBackup}" Margin="0,0,8,4"
                                                 AutomationProperties.AutomationId="BackupFullChoice" AutomationProperties.Name="Make a new full backup"
                                                 Content="Make a new full backup" ToolTip="Copies the whole card again, into a new folder" />
                                </WrapPanel>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <!-- Warnings and errors first: they must be read before starting (the status line counts them) -->
                    <ItemsControl ItemsSource="{Binding Alerts}" ItemTemplate="{StaticResource MessageTemplate}" Margin="2,0,0,10"
                                  AutomationProperties.AutomationId="BackupAlerts" Visibility="{Binding HasAlerts, Converter={StaticResource VisibleWhen}}" />
                    <UniformGrid Columns="3" Margin="-8,0,-8,20">
                        <UniformGrid.Resources>
                            <Style TargetType="Border" BasedOn="{StaticResource Card}">
                                <Setter Property="Padding" Value="18,14" />
                                <Setter Property="Margin" Value="8,0" />
                            </Style>
                        </UniformGrid.Resources>
                        <Border>
                            <StackPanel>
                                <TextBlock Text="{Binding CopyTileTitle}" Style="{StaticResource Overline}" />
                                <TextBlock Text="{Binding FilesCount}" AutomationProperties.AutomationId="BackupFilesCount" FontSize="22" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding FilesSize}" Style="{StaticResource TileCaption}" />
                            </StackPanel>
                        </Border>
                        <Border>
                            <StackPanel>
                                <TextBlock Text="TO" Style="{StaticResource Overline}" />
                                <TextBlock Text="{Binding DestinationsCount}" AutomationProperties.AutomationId="BackupDestinationsCount" FontSize="20" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding DestinationsDetail}" Style="{StaticResource TileCaption}" />
                            </StackPanel>
                        </Border>
                        <Border>
                            <StackPanel>
                                <TextBlock Text="TIME" Style="{StaticResource Overline}" />
                                <TextBlock Text="{Binding EstimateText}" FontSize="20" FontWeight="SemiBold" />
                                <TextBlock Text="estimate" Style="{StaticResource TileCaption}" />
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <ItemsControl ItemsSource="{Binding DestinationRows}" AutomationProperties.AutomationId="BackupTargets" Margin="0,0,0,10">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type local:DestinationRow}">
                                <DockPanel Margin="2,0,0,4">
                                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource Icon}" Text="&#xEDA2;" Margin="0,0,10,0" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Space}" Style="{StaticResource Caption}" Margin="12,0,0,0" />
                                    <TextBlock TextTrimming="CharacterEllipsis">
                                        <Run Text="{Binding Folder, Mode=OneWay}" FontWeight="SemiBold" />
                                        <Run Text="{Binding Drive, Mode=OneWay}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    </TextBlock>
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- How the copies are checked, and notes about the preview: behind a link, opened on a click -->
                    <local:InfoTip HorizontalAlignment="Left" PopupWidth="680" Label="Details"
                                   AutomationProperties.AutomationId="BackupNotesLink" AutomationProperties.Name="Details about this backup"
                                   Visibility="{Binding HasNotes, Converter={StaticResource VisibleWhen}}">
                        <ItemsControl ItemsSource="{Binding Notes}" ItemTemplate="{StaticResource MessageTemplate}" AutomationProperties.AutomationId="BackupNotes" />
                    </local:InfoTip>
                </StackPanel>
            </StackPanel>
            </Grid>
        </ScrollViewer>
    </DockPanel>
</UserControl>
